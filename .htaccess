# ══════════════════════════════════════════════
# SNTM SAP — .htaccess
# Domaine : sntm-sap.fr
# ══════════════════════════════════════════════

# ── Page d'erreur personnalisée ──────────────
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# ── HTTPS forcé ──────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── WWW → sans WWW ───────────────────────────
RewriteCond %{HTTP_HOST} ^www\.sntm-sap\.fr [NC]
RewriteRule ^(.*)$ https://sntm-sap.fr/$1 [L,R=301]

# ── Anciennes pages (V2) : redirections permanentes ──
Redirect 301 /services.html /nettoyage-professionnel-saint-tropez.html
Redirect 301 /sols.html /traitement-des-sols-saint-tropez.html

# ── Compression GZIP ─────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ── Cache navigateur ─────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp          "access plus 3 months"
  ExpiresByType image/png           "access plus 3 months"
  ExpiresByType image/jpeg          "access plus 3 months"
  ExpiresByType font/woff2          "access plus 1 year"
  ExpiresByType text/html           "access plus 1 day"
</IfModule>

# ── Sécurité headers ─────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # V2 : HTTPS imposé pendant un an (actif seulement sur les réponses en HTTPS)
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  # V2 : le site n'utilise ni caméra, ni micro, ni localisation, ni paiement
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # V2 : seules les ressources du site sont autorisées, plus EmailJS pour le formulaire
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://api.emailjs.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' mailto:; upgrade-insecure-requests"
  Header set Cross-Origin-Opener-Policy "same-origin"
</IfModule>